DB_NAME=example
DB_USER=example
DB_PASSWORD=example
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Base64로 인코딩된 32바이트 이상의 비밀키를 입력하세요.
# 생성 명령어: openssl rand -base64 32
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=30m
# Refresh Token 유효시간입니다.
REFRESH_TOKEN_EXPIRATION=14d
# 로컬 HTTP 환경에서는 false, HTTPS 배포 환경에서는 true로 설정하세요.
REFRESH_TOKEN_COOKIE_SECURE=false
# 허용값: Strict, Lax, None (None은 Secure=true가 필요합니다.)
REFRESH_TOKEN_COOKIE_SAME_SITE=Lax
