DB_NAME=example
DB_USER=example
DB_PASSWORD=example
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Render에서는 Blueprint가 PostgreSQL 연결 정보와 JWT Secret을 안전하게 주입합니다.
# 실제 배포용 비밀값은 이 파일이나 Git에 작성하지 마세요.
# Base64로 인코딩된 32바이트 이상의 비밀키를 입력하세요.
# 생성 명령어: openssl rand -base64 32
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=30m
# 인증코드와 인증 토큰을 HMAC-SHA256으로 보호하는 32바이트 이상의 비밀값입니다.
# 실제 환경에서는 JWT Secret과 다른 값을 사용하고 Git에 커밋하지 마세요.
# 생성 명령어: openssl rand -base64 32
EMAIL_VERIFICATION_SECRET=replace-with-a-random-secret-at-least-32-characters
EMAIL_VERIFICATION_CODE_EXPIRATION=5m
EMAIL_VERIFICATION_RESEND_COOLDOWN=60s
EMAIL_VERIFICATION_REQUEST_LIMIT_WINDOW=1h
EMAIL_VERIFICATION_MAX_REQUESTS=5
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_TOKEN_EXPIRATION=30m
# 로컬에서는 console, 배포 환경에서는 resend를 사용합니다.
EMAIL_DELIVERY_MODE=console
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_CONNECT_TIMEOUT=3s
EMAIL_READ_TIMEOUT=5s
# Refresh Token 유효시간입니다.
REFRESH_TOKEN_EXPIRATION=14d
# 로컬 HTTP 환경에서는 false, HTTPS 배포 환경에서는 true로 설정하세요.
REFRESH_TOKEN_COOKIE_SECURE=false
# 허용값: Strict, Lax, None (None은 Secure=true가 필요합니다.)
REFRESH_TOKEN_COOKIE_SAME_SITE=Lax
